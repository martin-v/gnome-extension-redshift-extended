<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.redshift-extended" path="/org/gnome/shell/extensions/redshift-extended/">
    <key name="start-time" type="i">
      <range min="0" max="1439"/>
      <default>1260</default>
      <summary>Start time in minutes after midnight</summary>
    </key>
    <key name="target-time" type="i">
      <range min="0" max="1439"/>
      <default>1380</default>
      <summary>Time at which the target values are reached</summary>
    </key>
    <key name="end-time" type="i">
      <range min="0" max="1439"/>
      <default>420</default>
      <summary>Time at which the original values are restored</summary>
    </key>
    <key name="target-temperature" type="u">
      <range min="1000" max="6500"/>
      <default>1800</default>
      <summary>Target night light temperature in Kelvin</summary>
    </key>
    <key name="target-brightness" type="i">
      <range min="1" max="100"/>
      <default>20</default>
      <summary>Target screen brightness in percent</summary>
    </key>
    <key name="original-temperature" type="u">
      <default>0</default>
      <summary>Saved night light temperature</summary>
    </key>
    <key name="applied-temperature" type="u">
      <default>0</default>
      <summary>Last temperature applied by the extension</summary>
    </key>
    <key name="original-brightness" type="i">
      <default>-1</default>
      <summary>Saved screen brightness</summary>
    </key>
    <key name="applied-brightness" type="i">
      <default>-1</default>
      <summary>Last screen brightness applied by the extension</summary>
    </key>
    <key name="last-noon-reset" type="s">
      <default>''</default>
      <summary>Last successful noon reset</summary>
    </key>
  </schema>
</schemalist>
